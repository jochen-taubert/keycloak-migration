### =============================================================================
### PHASE 2: keycloak.migration.oauth-client-enabled=true (KEYCLOAK_OAUTH_CLIENT_ENABLED)
### The app also acts as an OAuth2 Client: a request with no valid token gets
### redirected into Keycloak's own login (Authorization Code flow) instead of the
### legacy JSON 401. Once Keycloak issues a token for an already-migrated user, that
### token must be accepted by the same role-gated endpoint that phase 1 uses
### (/admin/whoami, hasRole("SYSTEM_ADMIN")) - roles now come from Keycloak's own
### realm_access.roles claim instead of the legacy AUTH_ROLES claim, mapped by the
### same shared KeycloakAuthorityMapper.
###
### Requires:
###  - KEYCLOAK_OAUTH_CLIENT_ENABLED=true and KEYCLOAK_MIGRATE_USERS=true
###  - The user already migrated to Keycloak - run phase1_legacy_migration.http first
###  - Keycloak reachable at {{keycloakUrl}}, realm {{keycloakRealm}}
###  - legacy_username / legacy_password / keycloakClientSecret set in
###    http-client.private.env.json (gitignored - copy
###    http-client.private.env.json.example to get started)
###
### NOTE: the full interactive round trip (redirect -> Keycloak's hosted login form
### -> callback -> browser session cookie) needs a real browser and can't be scripted
### here. What this file DOES verify with plain HTTP requests:
###  (a) an unauthenticated request is redirected into Keycloak, not just 401'd
###  (b) a genuine Keycloak-issued token (via password grant, standing in for "user
###      just finished the Keycloak login") is accepted by the same protected
###      endpoint, with roles correctly mapped from realm_access.roles
### =============================================================================

### 1. No token, oauth-client-enabled=true -> redirected into Keycloak's login
# IntelliJ's HTTP Client follows redirects by default. Disable "Follow redirects"
# (Settings > Tools > HTTP Client) to see the raw 302 + Location header, or just
# check response.url below - it should land on {{keycloakUrl}}/realms/.../auth.
GET {{baseUrl}}/api/admin/whoami

> {%
    client.test("Not a legacy 401 (oauth-client path took over)", function() {
        client.assert(response.status !== 401, "Got 401 - is oauth-client-enabled actually true?");
    });
    client.log("Final status: " + response.status + ", url: " + response.url);
%}

### 2. Get a genuine Keycloak token directly (password grant)
# Stands in for "user just completed Keycloak's hosted login form".
POST {{keycloakUrl}}/realms/{{keycloakRealm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{keycloakClientId}}&client_secret={{keycloakClientSecret}}
    &username={{legacy_username}}&password={{legacy_password}}

> {%
    client.test("Keycloak issued a token", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status + " - is the user migrated to Keycloak yet?");
    });

    if (response.status === 200) {
        client.global.set("keycloak_token", response.body.access_token);
        client.log("Keycloak token: " + response.body.access_token.substring(0, 50) + "...");

        var parts = response.body.access_token.split(".");
        var payload = JSON.parse(atob(parts[1].replace(/-/g, '+').replace(/_/g, '/')));
        client.log("realm_access.roles: " + JSON.stringify(payload.realm_access ? payload.realm_access.roles : "N/A"));
    } else {
        client.log("ERROR: " + JSON.stringify(response.body));
    }
%}

### 3. Protected endpoint reachable via the genuine Keycloak token
GET {{baseUrl}}/api/admin/whoami
Authorization: Bearer {{keycloak_token}}

> {%
    client.test("Keycloak token accepted for /admin/whoami", function() {
        client.assert(response.status === 200, "Expected 200 (needs SYSTEM_ADMIN realm role), got " + response.status);
    });

    if (response.status === 200) {
        client.log("whoami: " + JSON.stringify(response.body));
        client.test("Roles mapped to ROLE_SYSTEM_ADMIN from realm_access.roles", function() {
            client.assert(response.body.roles.indexOf("ROLE_SYSTEM_ADMIN") !== -1,
                "Expected ROLE_SYSTEM_ADMIN in " + JSON.stringify(response.body.roles));
        });
    }
%}

### 4. Keycloak token WITHOUT the SYSTEM_ADMIN realm role -> 403
# Point non_admin_username/non_admin_password (private env) at a migrated user that
# does NOT have SYSTEM_ADMIN, to prove authorization is actually enforced (not just
# authentication).
POST {{keycloakUrl}}/realms/{{keycloakRealm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{keycloakClientId}}&client_secret={{keycloakClientSecret}}&username={{non_admin_username}}&password={{non_admin_password}}

> {%
    if (response.status === 200) {
        client.global.set("keycloak_token_non_admin", response.body.access_token);
    }
%}

### 5.
GET {{baseUrl}}/api/admin/whoami
Authorization: Bearer {{keycloak_token_non_admin}}

> {%
    client.test("Non-admin Keycloak token -> 403", function() {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}
